{
    "name": "shipmonk/packing",
    "description": "Testing day application stub",
    "require": {
        "ext-pdo": "*",
        "ext-json": "*",
        "php": ">=8.4",
        "psr/http-message": "2.*",
        "psr/log": "^3.0",
        "guzzlehttp/psr7": "2.*",
        "doctrine/orm": "3.*",
        "symfony/dependency-injection": "^7.4",
        "symfony/config": "^7.4",
        "guzzlehttp/guzzle": "^7.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
